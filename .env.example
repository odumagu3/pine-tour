# -----------------------------------------------------------------------------
# BACKEND (Render) — server-side only. NEVER expose the service_role key.
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://dryjsgwprdcpmssxsumk.supabase.co
SUPABASE_URL="https://YOUR_REF.supabase.co"
# Service role key (secret) — bypasses RLS. Backend only.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# Comma-separated allowlist of frontend origins for CORS (use * only in dev).
FRONTEND_ORIGIN="http://localhost:5174"

# -----------------------------------------------------------------------------
# FRONTEND (Vercel) — Vite exposes only VITE_* vars to the browser (safe/public).
# -----------------------------------------------------------------------------
# Base URL of the backend REST API (the Render service URL in production).
VITE_API_URL="http://localhost:5174"
# Base URL of the backend WebSocket (ws:// locally, wss:// in production).
VITE_WS_URL="ws://localhost:5174"
# Supabase URL + publishable (anon) key — safe to ship to the browser.
VITE_SUPABASE_URL="https://YOUR_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_ANON_KEY"

# -----------------------------------------------------------------------------
# Existing (unrelated) keys
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
